# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/siteledger
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/siteledger
MONGODB_URI=mongodb://127.0.0.1:27017/siteledger

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Use * for development, restrict to your frontend origin in production
CORS_ORIGIN=*

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Include this header when calling POST /api/seed: x-seed-secret: <value>
SEED_SECRET=change_this_seed_secret
